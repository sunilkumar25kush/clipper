# ==============================================================================
# CLIPFORGE AI — GITIGNORE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/

# ------------------------------------------------------------------------------
# 2. BUILD OUTPUTS & COMPILED ARTIFACTS
# ------------------------------------------------------------------------------
dist/
build/
.next/
out/
*.tsbuildinfo
*.map

# Native & Binary Executables
*.exe
*.dll
*.so
*.dylib

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT VARIABLES & SENSITIVE CREDENTIALS (MANDATORY)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example

# Cryptographic Keys & Service Accounts
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
credentials.json
service-account*.json
*token*.json

# ------------------------------------------------------------------------------
# 4. PYTHON & AI PROCESSING SERVICES
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Faster-Whisper & HuggingFace Local Model Cache
models/
huggingface/
.cache/

# AI Service transcript runtime storage
services/ai-service/data/transcripts/*.json
!services/ai-service/data/transcripts/test-transcript-sample.json
!services/ai-service/data/transcripts/.gitkeep

# ------------------------------------------------------------------------------
# 5. VIDEO RENDERING, MEDIA STORAGE & SCRATCH DISKS
# ------------------------------------------------------------------------------
/tmp/clipforge/
jobs/
storage/
uploads/
temp/
tmp/
*.tmp
*.temp

# Video & Audio Raw Media
*.mp4
*.mov
*.wav
*.m4v
*.webm
*.avi
*.mkv
*.mp3
*.aac
*.flac

# Subtitle Intermediate Assets
*.ass
*.srt
*.vtt

# ------------------------------------------------------------------------------
# 6. LOCAL DATABASES & CACHE STORES
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.gz
*.dump

# Redis Dumps
dump.rdb

# Local Candidate Store
services/ai-service/data/candidates/*.json
!services/ai-service/data/candidates/.gitkeep

# ------------------------------------------------------------------------------
# 7. LOGS & DIAGNOSTICS
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
