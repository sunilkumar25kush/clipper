# ==============================================================================
# CLIPFORGE AI — MASTER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` at the monorepo root (or per-service `.env.local`)
# NEVER commit real API keys, secrets, or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & APPLICATION URLS
# ------------------------------------------------------------------------------
NODE_ENV="development"                           # development | test | production
LOG_LEVEL="info"                                 # debug | info | warn | error

# Frontend & Admin Portal URLs (Used for CORS, emails, and OAuth callbacks)
NEXT_PUBLIC_APP_NAME="ClipForge AI"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_CDN_URL="http://localhost:9000/clipforge-media"

# Backend API Server Configuration
API_HOST="0.0.0.0"
API_PORT=4000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Prisma ORM)
# ------------------------------------------------------------------------------
# Primary Pooled Connection String (PgBouncer / Supabase / Neon in production)
DATABASE_URL="postgresql://username:password@localhost:5432/clipforge?schema=public&connection_limit=20"

# Direct Connection String (Used by Prisma CLI for migrations)
DIRECT_DATABASE_URL="postgresql://username:password@localhost:5432/clipforge?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS & BULLMQ QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS_ENABLED="false"                        # Set to "true" for managed cloud Redis
REDIS_URL="redis://localhost:6379/0"

# BullMQ Queue Prefix
BULLMQ_PREFIX="clipforge"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION, SESSIONS & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate secrets via: openssl rand -hex 32
JWT_ACCESS_SECRET="replace_with_64_char_hex_random_access_secret_key_for_jwt_signing"
JWT_REFRESH_SECRET="replace_with_64_char_hex_random_refresh_secret_key_for_sessions"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie & Token Security
SESSION_COOKIE_NAME="cf_refresh_token"
SESSION_COOKIE_DOMAIN="localhost"
SESSION_COOKIE_SECURE="false"                    # Set to "true" in production (HTTPS)

# Argon2id Hashing Parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Shared Secret for Internal Communication (API / Video-Worker -> Python AI Service)
INTERNAL_SERVICE_API_KEY="replace_with_64_char_hex_internal_microservice_shared_secret"

# Future-Ready Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_oauth_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Transactional Email (Resend / SMTP for Email Verification & Password Reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="replace_with_smtp_or_resend_api_key"
EMAIL_FROM_ADDRESS="no-reply@clipforge.ai"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 / S3-COMPATIBLE OBJECT STORAGE
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="r2"                            # r2 | s3 | minio
STORAGE_REGION="auto"                            # "auto" for Cloudflare R2, or e.g. "ap-south-1" for AWS S3
STORAGE_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="replace_with_r2_or_s3_access_key_id"
STORAGE_SECRET_ACCESS_KEY="replace_with_r2_or_s3_secret_access_key"
STORAGE_BUCKET_NAME="clipforge-media"
STORAGE_FORCE_PATH_STYLE="false"                 # Set to "true" for local MinIO

# Presigned URL Expiration & Multipart Chunk Size
STORAGE_PRESIGNED_URL_TTL_SECONDS=900            # 15 minutes
STORAGE_MULTIPART_CHUNK_SIZE_BYTES=20971520      # 20 MB per part

# ------------------------------------------------------------------------------
# 6. PYTHON AI SERVICE & ML MODELS CONFIGURATION
# ------------------------------------------------------------------------------
AI_SERVICE_HOST="0.0.0.0"
AI_SERVICE_PORT=8000
AI_SERVICE_INTERNAL_URL="http://localhost:8000"

# Google Gemini API Configuration (Semantic Analysis & Clip Detection)
GEMINI_API_KEY="replace_with_your_google_gemini_api_key"
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"
GEMINI_PRO_MODEL="gemini-2.5-pro"
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.2
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Faster-Whisper Speech-to-Text Configuration
WHISPER_MODEL_SIZE="large-v3-turbo"              # tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_DEVICE="cuda"                            # cuda | cpu
WHISPER_COMPUTE_TYPE="float16"                   # float16 (GPU) | int8 (CPU)
WHISPER_CPU_THREADS=4

# Pyannote.audio Speaker Diarization Configuration
ENABLE_SPEAKER_DIARIZATION="true"
HUGGINGFACE_ACCESS_TOKEN="replace_with_hf_token_for_pyannote_diarization_3_1"

# OpenCV & MediaPipe Smart Cropping Configuration
VISION_SAMPLE_FPS=5                              # Frame sampling rate for face tracking
VISION_DEADZONE_RATIO=0.25                       # 25% deadzone before virtual camera pans

# ------------------------------------------------------------------------------
# 7. VIDEO WORKER & FFMPEG RENDERING CONFIGURATION
# ------------------------------------------------------------------------------
WORKER_SCRATCH_DIR="/tmp/clipforge/jobs"
WORKER_ANALYSIS_CONCURRENCY=2                    # Concurrent project analysis jobs per worker node
WORKER_RENDER_CONCURRENCY=3                      # Concurrent single-clip FFmpeg render jobs per worker node
FFMPEG_BINARY_PATH="/usr/bin/ffmpeg"
FFPROBE_BINARY_PATH="/usr/bin/ffprobe"
FFMPEG_THREADS_PER_JOB=4                         # Max CPU threads per FFmpeg encode process
FFMPEG_SUBPROCESS_TIMEOUT_MS=300000              # 5 minutes hard timeout per clip encode
WATERMARK_ASSET_PATH="/app/assets/watermark.png"

# ------------------------------------------------------------------------------
# 8. CONFIGURABLE SUBSCRIPTION TIER LIMITS & CREDITS
# ------------------------------------------------------------------------------
# Credits = Source Video Minutes Analyzed
PLAN_FREE_MONTHLY_CREDITS=60
PLAN_FREE_MAX_UPLOAD_MB=500
PLAN_FREE_MAX_DURATION_MINS=30
PLAN_FREE_MAX_CLIPS_PER_VIDEO=5
PLAN_FREE_RETENTION_DAYS=7

PLAN_STARTER_MONTHLY_CREDITS=300
PLAN_STARTER_MAX_UPLOAD_MB=2048
PLAN_STARTER_MAX_DURATION_MINS=90
PLAN_STARTER_MAX_CLIPS_PER_VIDEO=15
PLAN_STARTER_RETENTION_DAYS=30

PLAN_PRO_MONTHLY_CREDITS=1000
PLAN_PRO_MAX_UPLOAD_MB=5120
PLAN_PRO_MAX_DURATION_MINS=180
PLAN_PRO_MAX_CLIPS_PER_VIDEO=30
PLAN_PRO_RETENTION_DAYS=90

PLAN_BUSINESS_MONTHLY_CREDITS=3000
PLAN_BUSINESS_MAX_UPLOAD_MB=10240
PLAN_BUSINESS_MAX_DURATION_MINS=240
PLAN_BUSINESS_MAX_CLIPS_PER_VIDEO=50
PLAN_BUSINESS_RETENTION_DAYS=180

# ------------------------------------------------------------------------------
# 9. PAYMENT GATEWAYS (Razorpay Primary + Stripe Future-Ready)
# ------------------------------------------------------------------------------
ACTIVE_PAYMENT_PROVIDER="RAZORPAY"               # RAZORPAY | STRIPE

# Razorpay Credentials (Indian Payments: UPI, Cards, NetBanking)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_with_your_key_id"
RAZORPAY_KEY_ID="rzp_test_replace_with_your_key_id"
RAZORPAY_KEY_SECRET="replace_with_your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_your_razorpay_webhook_secret"
RAZORPAY_PLAN_ID_STARTER="plan_starter_placeholder"
RAZORPAY_PLAN_ID_PRO="plan_pro_placeholder"
RAZORPAY_PLAN_ID_BUSINESS="plan_business_placeholder"

# Stripe Credentials (International Payments — Future-Ready Adapter)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_webhook_secret"
STRIPE_PRICE_ID_STARTER="price_starter_placeholder"
STRIPE_PRICE_ID_PRO="price_pro_placeholder"
STRIPE_PRICE_ID_BUSINESS="price_business_placeholder"

